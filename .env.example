# Environment Configuration for WorkSense AI

# Database Configuration
# Primary: PostgreSQL (e.g., postgresql+psycopg2://postgres:your_password@localhost:5432/worksense_ai)
# For automated tests or local sandbox when PostgreSQL port is not bound, falls back to sqlite:///./worksense.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/worksense_ai

# Security & JWT Authentication
SECRET_KEY=worksense-super-secret-jwt-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Configuration
APP_NAME=WorkSense AI
APP_ENV=development
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Workload Calculation Engine Parameters (Configurable)
REPORTING_PERIOD_DAYS=7
COMPLEXITY_WEIGHT_EASY=1.0
COMPLEXITY_WEIGHT_MEDIUM=1.2
COMPLEXITY_WEIGHT_HARD=1.5
COMPLEXITY_WEIGHT_CRITICAL=2.0

# Utilization Classification Thresholds (Percentage)
UTILIZATION_THRESHOLD_UNDERUTILIZED=40.0
UTILIZATION_THRESHOLD_BALANCED_MAX=80.0
UTILIZATION_THRESHOLD_HIGH_MAX=100.0

# Demo Admin Seed Account (for initial bootstrap)
DEMO_ADMIN_NAME="System Administrator"
DEMO_ADMIN_EMAIL=admin@worksense.ai
DEMO_ADMIN_PASSWORD=AdminPassword123!
